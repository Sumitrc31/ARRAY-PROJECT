/* Count the total number of books issued per member */
SELECT member_id, COUNT(issue_id) 
FROM Issues 
GROUP BY member_id;
/* Calculate the total fine collected */
SELECT SUM(amount) 
FROM Fines 
WHERE paid='No';
/* Get the average number of days to return a book */
SELECT AVG(DATEDIFF(return_date, issue_date)) 
FROM Issues;
/* Find the number of books reserved by each member */
SELECT member_id, COUNT(res_id) 
FROM Reservations 
GROUP BY member_id;
/* List the top 2 members with the most book issues */
SELECT member_id, COUNT(issue_id) AS total_issues 
FROM Issues 
GROUP BY member_id 
ORDER BY total_issues DESC 
LIMIT 2;

-- B --

/* List all issued books with member names (INNER JOIN) */
SELECT i.issue_id, b.title, m.name 
FROM Issues i 
INNER JOIN Books b ON i.book_id=b.book_id 
INNER JOIN Members m ON i.member_id=m.member_id;
/* Show all books and who reserved them (LEFT JOIN) */
SELECT b.book_id, b.title, m.name 
FROM Books b 
LEFT JOIN Reservations r ON b.book_id=r.book_id 
LEFT JOIN Members m ON r.member_id=m.member_id;
/* List all members and books they issued, even if none (RIGHT JOIN) */
SELECT m.member_id, m.name, b.title 
FROM Issues i 
RIGHT JOIN Members m ON i.member_id=m.member_id 
LEFT JOIN Books b ON i.book_id=b.book_id;
/* Get all fine details with member names (FULL JOIN) */
SELECT f.fine_id, f.amount, m.name 
FROM Fines f 
LEFT JOIN Issues i ON f.issue_id=i.issue_id 
LEFT JOIN Members m ON i.member_id=m.member_id
UNION
SELECT f.fine_id, f.amount, m.name 
FROM Fines f 
RIGHT JOIN Issues i ON f.issue_id=i.issue_id 
RIGHT JOIN Members m ON i.member_id=m.member_id;

/* Show librarians and the books issued during their shift (LEFT JOIN) */
SELECT l.lib_id, l.name, b.title 
FROM Librarians l 
LEFT JOIN Issues i ON 1=1 
LEFT JOIN Books b ON i.book_id=b.book_id;
/* Display all members and their reservations (INNER JOIN) */
SELECT m.member_id, m.name, b.title 
FROM Members m 
INNER JOIN Reservations r ON m.member_id=r.member_id 
INNER JOIN Books b ON r.book_id=b.book_id;
/* Show all books and reservation status (RIGHT JOIN) */
SELECT b.book_id, b.title, r.res_id 
FROM Reservations r 
RIGHT JOIN Books b ON r.book_id=b.book_id;
/* List members and their total fines (INNER JOIN) */
SELECT m.member_id, m.name, SUM(f.amount) 
FROM Members m 
INNER JOIN Issues i ON m.member_id=i.member_id 
INNER JOIN Fines f ON i.issue_id=f.issue_id 
GROUP BY m.member_id, m.name;
/* Display all books, including those never issued (FULL JOIN) */
SELECT b.book_id, b.title, i.issue_id 
FROM Books b 
LEFT JOIN Issues i ON b.book_id=i.book_id
UNION
SELECT b.book_id, b.title, i.issue_id 
FROM Books b 
RIGHT JOIN Issues i ON b.book_id=i.book_id;
/* Show all members and librarians they interacted with (LEFT JOIN) */
SELECT m.member_id, m.name, l.name 
FROM Members m 
LEFT JOIN Issues i ON m.member_id=i.member_id 
LEFT JOIN Librarians l ON 1=1;


