CREATE DATABASE HospitalDB;
USE HospitalDB;

CREATE TABLE Departments(department_id VARCHAR(10) PRIMARY KEY, name VARCHAR(50));

CREATE TABLE Patients(patient_id VARCHAR(10) PRIMARY KEY, name VARCHAR(50), age INT, gender VARCHAR(10), contact VARCHAR(20));

CREATE TABLE Doctors(doctor_id VARCHAR(10) PRIMARY KEY, name VARCHAR(50), specialty VARCHAR(50), department_id VARCHAR(10), FOREIGN KEY (department_id) REFERENCES Departments(department_id));

CREATE TABLE Appointments(appointment_id VARCHAR(10) PRIMARY KEY, patient_id VARCHAR(10), doctor_id VARCHAR(10), date DATE, time TIME, diagnosis VARCHAR(100), FOREIGN KEY (patient_id) REFERENCES Patients(patient_id), FOREIGN KEY (doctor_id) REFERENCES Doctors(doctor_id));

CREATE TABLE Medications(med_id VARCHAR(10) PRIMARY KEY, name VARCHAR(50), cost INT);

CREATE TABLE Prescriptions(prescription_id VARCHAR(10) PRIMARY KEY, appointment_id VARCHAR(10), med_id VARCHAR(10), dosage VARCHAR(50), FOREIGN KEY (appointment_id) REFERENCES Appointments(appointment_id), FOREIGN KEY (med_id) REFERENCES Medications(med_id));

