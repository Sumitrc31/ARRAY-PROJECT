-- B --

/* Get all students with their course name and instructor name (INNER JOIN) */
SELECT s.student_id, s.name, c.course_name, i.name 
FROM Students s 
INNER JOIN Enrollments e ON s.student_id=e.student_id 
INNER JOIN Courses c ON e.course_id=c.course_id 
INNER JOIN Teaches t ON c.course_id=t.course_id 
INNER JOIN Instructors i ON t.instructor_id=i.instructor_id;

/* List all courses with the names of enrolled students (LEFT JOIN) */
SELECT c.course_id, c.course_name, s.name 
FROM Courses c 
LEFT JOIN Enrollments e ON c.course_id=e.course_id 
LEFT JOIN Students s ON e.student_id=s.student_id;

/* Show all instructors and the courses they teach, including those who teach none */
SELECT i.instructor_id, i.name, c.course_name 
FROM Instructors i 
LEFT JOIN Teaches t ON i.instructor_id=t.instructor_id 
LEFT JOIN Courses c ON t.course_id=c.course_id;

/* List all departments and the students in them (FULL JOIN) */
SELECT d.dept_id, d.dept_name, s.student_id, s.name 
FROM Departments d 
LEFT JOIN Students s ON d.dept_id=s.dept_id
UNION
SELECT d.dept_id, d.dept_name, s.student_id, s.name 
FROM Departments d 
RIGHT JOIN Students s ON d.dept_id=s.dept_id;

/* Show all students and their grades, even if not enrolled */
SELECT s.student_id, s.name, e.grade 
FROM Students s 
LEFT JOIN Enrollments e ON s.student_id=e.student_id;

/* List instructors and all courses, including those without assigned instructors (FULL JOIN) */
SELECT i.instructor_id, i.name, c.course_name 
FROM Instructors i 
LEFT JOIN Teaches t ON i.instructor_id=t.instructor_id
LEFT JOIN Courses c ON t.course_id=c.course_id
UNION
SELECT i.instructor_id, i.name, c.course_name 
FROM Instructors i 
RIGHT JOIN Teaches t ON i.instructor_id=t.instructor_id
RIGHT JOIN Courses c ON t.course_id=c.course_id;

/* List students who are not enrolled in any course */
SELECT s.student_id, s.name 
FROM Students s 
LEFT JOIN Enrollments e ON s.student_id=e.student_id 
WHERE e.student_id IS NULL;

/* Find all instructors who teach in Semester 2 */
SELECT i.instructor_id, i.name 
FROM Instructors i 
INNER JOIN Teaches t ON i.instructor_id=t.instructor_id 
WHERE t.semester='Semester 2';

/* Get all students and the department heads */
SELECT s.student_id, s.name, d.head 
FROM Students s 
INNER JOIN Departments d ON s.dept_id=d.dept_id;

/* Show all courses with department names, even if not assigned to any department */
SELECT c.course_id, c.course_name, d.dept_name 
FROM Courses c 
LEFT JOIN Departments d ON c.dept_id=d.dept_id;


