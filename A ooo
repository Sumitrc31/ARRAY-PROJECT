/* Show all medications prescribed and appointments (FULL JOIN) */
SELECT m.med_id, m.name, a.appointment_id
FROM Medications m
LEFT JOIN Prescriptions p ON m.med_id=p.med_id
LEFT JOIN Appointments a ON p.appointment_id=a.appointment_id
