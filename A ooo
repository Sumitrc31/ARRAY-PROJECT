/* Find the average grade of students enrolled in "Database Systems" */
SELECT AVG(grade) FROM Enrollments e JOIN Courses c ON e.course_id=c.course_id WHERE c.course_name='Database';

 /* List the number of courses offered by each department */
SELECT dept_id, COUNT(course_id) FROM Courses GROUP BY dept_id;

 /* Find the total number of students in each course */
SELECT course_id, COUNT(student_id) FROM Enrollments GROUP BY course_id;

 /* List all students who are enrolled in at least one course and their department */
SELECT DISTINCT s.student_id, s.name, s.dept_id FROM Students s JOIN Enrollments e ON s.student_id=e.student_id;

 /* Find the max salary of instructors in each department */
