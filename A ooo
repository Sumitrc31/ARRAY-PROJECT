CREATE DATABASE LibraryDB;
USE LibraryDB;

CREATE TABLE Books(book_id VARCHAR(10) PRIMARY KEY, title VARCHAR(100), author VARCHAR(50), genre VARCHAR(30), pub_year INT);

CREATE TABLE Members(member_id VARCHAR(10) PRIMARY KEY, name VARCHAR(50), email VARCHAR(100), join_date DATE);

CREATE TABLE Librarians(lib_id VARCHAR(10) PRIMARY KEY, name VARCHAR(50), shift_time VARCHAR(20));

CREATE TABLE Issues(issue_id VARCHAR(10) PRIMARY KEY, book_id VARCHAR(10), member_id VARCHAR(10), issue_date DATE, return_date DATE, FOREIGN KEY (book_id) REFERENCES Books(book_id), FOREIGN KEY (member_id) REFERENCES Members(member_id));

CREATE TABLE Fines(fine_id VARCHAR(10) PRIMARY KEY, issue_id VARCHAR(10), amount INT, paid VARCHAR(10), FOREIGN KEY (issue_id) REFERENCES Issues(issue_id));

CREATE TABLE Reservations(res_id VARCHAR(10) PRIMARY KEY, book_id VARCHAR(10), member_id VARCHAR(10), res_date DATE, FOREIGN KEY (book_id) REFERENCES Books(book_id), FOREIGN KEY (member_id) REFERENCES Members(member_id));

