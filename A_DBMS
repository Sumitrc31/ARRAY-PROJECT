CREATE DATABASE LAB_FINAL_PRACTICE;
USE TT;
CREATE TABLE STUDENT (S_ID VARCHAR(10) PRIMARY KEY, S_NAME VARCHAR(40) NOT NULL, EMAIL VARCHAR(50) UNIQUE, AGE INT CHECK (AGE>0) );
CREATE TABLE TEACHERS (T_ID VARCHAR(10) PRIMARY KEY, T_NAME VARCHAR(40) NOT NULL, DEPT VARCHAR(50) NOT NULL, SALARY INT CHECK (SALARY>0) );
CREATE TABLE COURSES (C_ID VARCHAR(10) PRIMARY KEY, C_TITLE VARCHAR(40) NOT NULL, CREDIT INT, T_ID VARCHAR(10), FOREIGN KEY (T_ID) REFERENCES TEACHERS (T_ID) ON DELETE CASCADE ON UPDATE CASCADE);
CREATE TABLE CLASSROOM (R_ID VARCHAR(10) PRIMARY KEY, BUILDING VARCHAR(40) NOT NULL, CAPACITY INT CHECK (CAPACITY>30) );
CREATE TABLE ENROLLMENT(E_ID VARCHAR(10) PRIMARY KEY, S_ID VARCHAR(40),FOREIGN KEY (S_ID) REFERENCES STUDENT (S_ID) ON DELETE CASCADE ON UPDATE CASCADE, C_ID VARCHAR(10), FOREIGN KEY (C_ID) REFERENCES COURSES (C_ID) ON DELETE CASCADE ON UPDATE CASCADE, GRADE VARCHAR(2) CHECK (GRADE IN('A', 'B','C','D','E','F')));

